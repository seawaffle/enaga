template <class T> constexpr bool isnan(T x) { return __builtin_isnan(x); }
template <class T> constexpr bool isinf(T x) { return __builtin_isinf(x); }
template <class T> constexpr bool isfinite(T x) { return __builtin_isfinite(x); }
template <class T> constexpr bool isnormal(T x) { return __builtin_isnormal(x); }
template <class T> constexpr bool signbit(T x) { return __builtin_signbit(x); }
template <class T> constexpr int fpclassify(T x) {
    return __builtin_fpclassify(FP_NAN, FP_INFINITE, FP_NORMAL, FP_SUBNORMAL, FP_ZERO, x);
}

